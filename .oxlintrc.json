{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "react"
    ],
    "categories": {
        "correctness": "warn"
    },
    "rules": {
        "typescript/no-explicit-any": "error"
    },
    "env": {
        "browser": true,
        "node": true
    },
    "ignorePatterns": [
        "build/**",
        "node_modules/**",
        "public/**",
        ".venv/**",
        "coverage/**"
    ]
}