{
    "homepage": "https://www.pattygcoding.com",
    "name": "react-portfolio",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "dependencies": {
        "bootstrap": "^5.2.3",
        "emailjs-com": "^3.2.0",
        "js-yaml": "^4.1.1",
        "node": "^18.20.0",
        "prismjs": "^1.30.0",
        "react": "^18.2.0",
        "react-bootstrap": "^2.7.0",
        "react-country-flag": "^3.1.0",
        "react-dom": "^18.2.0",
        "react-helmet-async": "^1.0.7",
        "react-icons": "^4.1.0",
        "react-router-dom": "^6.6.2",
        "react-simple-code-editor": "^0.14.1",
        "react-simple-maps": "^3.0.0",
        "react-transition-group": "^4.4.2",
        "react-zoom-pan-pinch": "^3.7.0",
        "typewriter-effect": "^2.18.2",
        "web-vitals": "^3.1.1"
    },
    "scripts": {
        "start": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "postbuild": "tsx scripts/generate-og-pages.ts && tsx scripts/generate-redirects.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "translate": "python src/assets/lang/lang.py",
        "translate:skip": "python src/assets/lang/lang.py --skip",
        "translate:retry": "python src/assets/lang/lang.py --retry",
        "predeploy": "yarn build && copy build\\index.html build\\404.html",
        "deploy": "gh-pages -d build"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22",
        "@types/prismjs": "^1.26.6",
        "@types/react": "18",
        "@types/react-dom": "18",
        "@types/react-simple-maps": "^3.0.6",
        "@types/react-transition-group": "^4.4.12",
        "@vitejs/plugin-react": "^6.1.2",
        "gh-pages": "^6.1.1",
        "jsdom": "^29",
        "oxlint": "^1.87.0",
        "tsx": "^4.23.15",
        "typescript": "7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "resolutions": {
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7"
    }
}
